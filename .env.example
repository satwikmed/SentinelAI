# SentinelAI environment
ENVIRONMENT=development
DEBUG=true

# At least one key enables live providers; leave all empty for demo/mock mode
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db
CHECKPOINT_DB_PATH=./checkpoints.db
CHROMA_PERSIST_DIR=./chroma_data
DOCS_DIR=./data/docs

DEFAULT_COST_CEILING_USD=0.05
PROVIDER_TIMEOUT_SECONDS=30
MAX_REFLECTION_RETRIES=2

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sentinelai-gateway
